# ── Build stage ───────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Serve stage ───────────────────────────────────────────────
FROM nginx:alpine-3.19

COPY --from=build /app/dist /usr/share/nginx/html
# nginx:alpine's entrypoint runs envsubst on *.conf.template files automatically
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

ENV NGINX_BACKEND_URL=http://localhost:8002

EXPOSE 80
