# Copy to .env and set your OpenAI key.
# cp backend/.env.example backend/.env
#
# DATABASE_URL is intentionally absent here.
#   - Docker Compose sets it via the service `environment:` block (postgres → service name).
#   - Local dev without Docker uses the pydantic-settings default (localhost:5432).
#   - If you need a custom URL for local dev, add it here:
#     DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdemo

OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
